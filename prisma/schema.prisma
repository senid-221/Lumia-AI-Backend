generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { OWNER ADMIN AGENT }
enum OrderStatus { PENDING CONFIRMED PROCESSING READY DELIVERED CANCELLED }
enum MessageRole { USER ASSISTANT SYSTEM }

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
}
model Business {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  phone              String?
  whatsappPhone      String?
  timezone           String            @default("Africa/Kigali")
  instructions       String?
  address            String?
  description        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  memberships        Membership[]
  customers          Customer[]
  products           Product[]
  knowledge          KnowledgeItem[]
  knowledgeChunks    KnowledgeChunk[]
  conversations      Conversation[]
  orders             Order[]
  whatsapp           WhatsAppAccount?
  subscription       Subscription?
  usageRecords       UsageRecord[]
  customerMemories   CustomerMemory[]
}
model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       Role     @default(AGENT)
  user       User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  business   Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  @@unique([userId,businessId])
  @@index([businessId])
}
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
}
model Customer {
  id            String         @id @default(cuid())
  businessId    String
  name          String?
  phone         String?
  externalId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields:[businessId], references:[id], onDelete:Cascade)
  conversations Conversation[]
  orders        Order[]
  memories      CustomerMemory[]
  @@unique([businessId,phone])
  @@index([businessId])
}
model Conversation {
  id         String    @id @default(cuid())
  businessId String
  customerId String
  status     String    @default("AI")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields:[businessId], references:[id], onDelete:Cascade)
  customer   Customer  @relation(fields:[customerId], references:[id], onDelete:Cascade)
  messages   Message[]
  @@index([businessId,updatedAt])
}
model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  externalId     String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
  @@index([conversationId,createdAt])
  @@unique([conversationId,externalId])
}
model Product {
  id          String      @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal     @db.Decimal(14,2)
  currency    String      @default("RWF")
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields:[businessId], references:[id], onDelete:Cascade)
  orderItems  OrderItem[]
  @@index([businessId,active])
}
model KnowledgeItem {
  id         String          @id @default(cuid())
  businessId String
  title      String
  content    String
  source     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  business   Business        @relation(fields:[businessId], references:[id], onDelete:Cascade)
  chunks     KnowledgeChunk[]
  @@index([businessId])
}
model KnowledgeChunk {
  id              String        @id @default(cuid())
  businessId      String
  knowledgeItemId String
  chunkIndex      Int
  content         String
  embedding       Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  business        Business      @relation(fields:[businessId], references:[id], onDelete:Cascade)
  knowledgeItem   KnowledgeItem @relation(fields:[knowledgeItemId], references:[id], onDelete:Cascade)
  @@unique([knowledgeItemId,chunkIndex])
  @@index([businessId])
}
model Order {
  id         String      @id @default(cuid())
  businessId String
  customerId String
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(14,2)
  currency   String      @default("RWF")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  business   Business    @relation(fields:[businessId], references:[id], onDelete:Cascade)
  customer   Customer    @relation(fields:[customerId], references:[id], onDelete:Cascade)
  items      OrderItem[]
  @@index([businessId,createdAt])
}
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(14,2)
  order     Order    @relation(fields:[orderId], references:[id], onDelete:Cascade)
  product   Product  @relation(fields:[productId], references:[id])
}
model WhatsAppAccount {
  id            String   @id @default(cuid())
  businessId    String   @unique
  phoneNumberId String
  accessToken   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
}
model Subscription {
  id           String   @id @default(cuid())
  businessId   String   @unique
  plan         String   @default("STARTER")
  status       String   @default("TRIALING")
  monthlyPrice Decimal  @db.Decimal(14,2) @default(0)
  renewsAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
}
model UsageRecord {
  id          String   @id @default(cuid())
  businessId  String
  period      String
  messages    Int      @default(0)
  aiRuns      Int      @default(0)
  whatsappIn  Int      @default(0)
  whatsappOut Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  @@unique([businessId,period])
}
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String   @unique
  payload    Json
  createdAt  DateTime @default(now())
  @@index([provider,createdAt])
}
model CustomerMemory {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  key        String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  customer   Customer @relation(fields:[customerId], references:[id], onDelete:Cascade)
  @@unique([businessId,customerId,key])
  @@index([businessId,customerId])
}
